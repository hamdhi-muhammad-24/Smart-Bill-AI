# Copy to .env and fill in real values — never commit .env
# CORS_ORIGINS — JSON array of allowed frontend origins (update for production)
# CORS_ORIGINS=["https://billing.slt.lk"]
DATABASE_URL=postgresql://postgres:password@localhost:5432/slt_ebill
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# Auth — MS Entra ID
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id

# Auth — JWT for PDF Tokens (change JWT_SECRET to a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Short-lived signed PDF link tokens (itsdangerous)
PDF_TOKEN_SECRET=change-me-pdf-token-secret
PDF_TOKEN_EXPIRE_SECONDS=300

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="SLT Billing <billing@slt.lk>"
EMAIL_USE_SIGNED_LINK=false

# SMS
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Notifier
NOTIFY_MAX_ATTEMPTS=3

# AWS — required when EMAIL_BACKEND=ses or when using S3 PDF storage
# Credentials are auto-loaded from ECS task role in production (no keys needed)
# For local testing: set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY in your shell
AWS_REGION=ap-southeast-1
S3_BUCKET=slt-bill-pdfs-prod

# CORS — JSON array of allowed frontend origins (update for production)
# CORS_ORIGINS=["https://billing.yourdomain.com"]
